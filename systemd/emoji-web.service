[Unit]
Description=Discord Emoji Bot admin web
After=network-online.target
Wants=network-online.target

[Service]
User=emojibot
Group=emojibot
EnvironmentFile=/etc/emoji-bot/emoji-bot.env
WorkingDirectory=/opt/emoji-bot
# 워커 1개(스레드 8개): 로그인 실패 횟수를 메모리에 두기 때문
ExecStart=/opt/emoji-bot/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 300 --access-logfile - --bind 0.0.0.0:${WEB_PORT} emojibot.web:app
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/emoji-bot

[Install]
WantedBy=multi-user.target
